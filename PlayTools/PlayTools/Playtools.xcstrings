        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "을(를) 다시 눌러 마우스 커서를 놓으면 화면의 요소를 클릭할 수 있습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键以释放鼠标指针，点击画面元素"
