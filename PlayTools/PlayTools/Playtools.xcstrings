      }
    },
    "hint.showCursor.content.after" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "erneut, um den Mauszeiger loszulassen und auf ein beliebiges Element auf dem Bildschirm zu klicken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "again to release mouse cursor to click on any element on screen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "otra vez para soltar el cursor del ratón y hacer clic en cualquier elemento de la pantalla"
