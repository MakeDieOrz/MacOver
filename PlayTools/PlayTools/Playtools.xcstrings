            "state" : "translated",
            "value" : "按键映射编辑器"
          }
        }
      }
    },
    "hint.mouseMapping.content.after" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", um den Mauszeiger zu erfassen und die volle Mapping-Funktionalität zu aktivieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "to capture mouse cursor to enable full mapping functionality"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "capturar el cursor del ratón para habilitar la funcionalidad de mapeo completo"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تا نشانه موس ضبط شود و تمامی قابلیت‌های Keymap فعال شوند"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pour capturer le curseur de la souris pour activer la fonctionnalité de mappage complète"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "per catturare il cursore del mouse per abilitare la funzionalità di mappatura"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "을(를) 눌러 마우스 커서를 캡처하면 전체 매핑 기능을 사용할 수 있습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键以捕获鼠标指针，启用完整映射"
          }
        }
      }
    },
    "hint.mouseMapping.content.before" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einige Kartenfunktionen ist es erforderlich, dass der Mauszeiger erfasst wird, um wirksam zu werden\nDrücke"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some mapping functionalities require the mouse cursor captured to take effect\nPress"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas funcionalidades de mapeo requieren la captura del cursor del ratón para tener efecto\nPulse"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برخی از قابلیت‌های Keymap به ضبط نشانه موس نیاز دارد که اجرا شوند\nفشار دهید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines fonctionnalités de mappage nécessitent que le curseur de la souris soit capturé pour prendre effet\nAppuyez sur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune funzionalità di mappatura richiedono che il cursore del mouse sia catturato per avere effetto\nPremi"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 매핑 기능을 사용하려면 마우스 커서를 캡처해야 합니다\n키"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分映射功能需捕获鼠标指针才能生效\n按"
          }
        }
      }
    },
    "hint.mouseMapping.title" : {
      "extractionState" : "manual",
      "localizations" : {
