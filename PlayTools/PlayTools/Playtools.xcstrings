        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای آزادسازی نشانه موس روی هر المانی روی صفحه کلیک کنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "de nouveau pour libérer le curseur de la souris pour cliquer sur n'importe quel élément à l'écran"
