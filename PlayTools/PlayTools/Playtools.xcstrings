{
  "sourceLanguage" : "en",
  "strings" : {
    "hint.keymapSaved" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keymap gespeichert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keymap Saved"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa de teclas guardado"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keymap ذخیره شد"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keymap sauvegardé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappatura tasti Salvata"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키맵 저장됨"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按键映射已保存"
          }
        }
      }
    },
    "hint.keymappingEditor.content" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf einen leeren Bereich, um eine neue Zuordnung zu erstellen\nZiehe eine Schaltfläche, um ihre Position zu bearbeiten\nDrücke eine Taste, um sie an die ausgewählte Schaltfläche zu binden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click an empty area to create new mapping\nDrag a button to edit its position\nPress a key to bind it to the selected button"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haga clic en un área vacía para crear una nueva asignación\nArrastre un botón para modificar su posición\nPulse una tecla para asociarla al botón seleccionado"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی یک جای خالی کلیک کنید تا یک دکمه جدید ساخته شود\nدکمه را برای جابجای به هر جایی که می‌خواهید بکشید\nکلیدی که می‌خواهید به دکمه انتخاب‌شده وصل شود را فشار دهید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une zone vide pour créer un nouveau mappage\nFaites glisser un bouton pour modifier sa position\nAppuyez sur une touche pour l'assigner au bouton sélectionné"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare clic su un'area vuota per creare una nuova mappatura\nTrascinare un pulsante per modificare la sua posizione\nPremere un tasto per legarlo al pulsante selezionato"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈 영역을 클릭하여 새 매핑을 만듭니다\n버튼을 드래그하여 위치를 수정합니다\n키를 눌러 선택한 버튼에 바인딩합니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击空白位置以创建新映射\n拖动按钮以更改其位置\n按下想绑定的键以绑定到选中按钮"
          }
        }
      }
    },
