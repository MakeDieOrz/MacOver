    "alert.power.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some apps will not work with Low Power Mode enabled. It is recommended to disable it."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some apps will not work with Low Power Mode enabled. It is recommended to disable it."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle apps fungerer ikke med energibesparende tilstand aktiveret. Det anbefales at deaktivere det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Apps funktionieren nicht, wenn der Energiesparmodus aktiviert ist. Es wird empfohlen, es zu deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some apps will not work with Low Power Mode enabled. It is recommended to disable it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas aplicaciones no funcionarán con el modo de bajo consumo activado. Se recomienda desactivarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برخی برنامه‌ها در حالت ذخیره‌ی انرژی با اختلال روبرو خواهند شد. پیشنهاد می‌شود که آن را غیرفعال کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines applications ne fonctionneront pas si le mode faible consommation d'énergie est activé. Il est recommandé de le désactiver."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लो पावर मोड सक्षम होने पर कुछ ऐप काम नहीं करेंगे। लो पावर मोड को अक्षम करने की अनुशंसा की जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa aplikasi tidak akan berfungsi dengan Mode Daya Rendah diaktifkan. Disarankan untuk menonaktifkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune app potrebbero non funzionare con la Modalità Risparmio energetico attivata. Si consiglia di disattivarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のアプリは、低電力モードが有効になっていると動作しません。 無効にすることをお勧めします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 앱은 저전력 모드가 켜져 있는 경우 작동하지 않을 수 있습니다. 저전력 모드를 끄는 것을 권장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns aplicativos não irão funcionar com o Modo Pouca Energia. Recomenda-se desabilitá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
