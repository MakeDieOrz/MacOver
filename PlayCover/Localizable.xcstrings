        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayCover skal være i applicationmappen for at køre ordentligt. Klik på nedenstående knap for at flytte PlayCover automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayCover muss im Anwendungsordner sein, damit es ordnungsgemäß ausgeführt werden kann. Drücke die untere Schaltfläche, um PlayCover automatisch zu verschieben."
          }
        },
        "en" : {
