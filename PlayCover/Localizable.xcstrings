    "alert.app.clearPlayChain" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All PlayChain data will be erased. You may need to login to the app again. Do you wish to continue?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All PlayChain data will be erased. You may need to login to the app again. Do you wish to continue?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al PlayChain data slettes. Du skal muligvis logge ind i appen igen. Ønsker du at fortsætte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle PlayChain-Daten werden gelöscht. Möglicherweise muss du dich erneut bei der App anmelden. Möchtest du fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All PlayChain data will be erased. You may need to login to the app again. Do you wish to continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán todos los datos de PlayChain. Es posible que tenga que volver a iniciar sesión en la aplicación. ¿Desea continuar?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمام داده های PlayChain پاک خواهد شد. ممکن است لازم باشد دوباره وارد برنامه شوید. آیا مایل هستید ادامه دهید؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les données PlayChain seront effacées . Vous devrez peut-être vous reconnecter à l'application . Souhaitez-vous continuer ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All PlayChain data will be erased. You may need to login to the app again. Do you wish to continue?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua data PlayChain akan dihapus. Anda mungkin perlu masuk ke aplikasi lagi. Apakah Anda ingin melanjutkan?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i dati PlayChain verranno cancellati. Potrebbe essere necessario effettuare nuovamente l'accesso all'app. Vuoi continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての PlayChain データが消去されます。 アプリへの再ログインが必要になる場合があります。 続けますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 PlayChain 데이터가 지워집니다. 앱에 다시 로그인해야 할 수 있습니다. 계속하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dados do PlayChain serão apagados. Pode ser necessário precisar fazer login no aplicativo de novo. Deseja continuar?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All PlayChain data will be erased. You may need to login to the app again. Do you wish to continue?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все данные PlayChain будут удалены. Возможно, вам придется снова проходить авторизацию в приложении. Вы хотите продолжить?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütün PlayChain datası silinecektir. Uygulamaya tekrar giriş yapmanız gerekebilir. Devam etmek istiyor musunuz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All PlayChain data will be erased. You may need to login to the app again. Do you wish to continue?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả dữ liệu của PlayChain sẽ bị xóa. Bạn có thể cần phải đăng nhập lại vào ứng dụng. Bạn có muốn tiếp tục không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 PlayChain 数据将被清除。您可能需要重新登录 APP。您想要继续吗?"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 PlayChain 數據將被清除。您可能需要重新登錄應用程式。 您還希望繼續嗎?"
          }
        }
      }
    },
    "alert.app.delete" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All app data will be erased. You may need to download app files again. Do you wish to continue?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All app data will be erased. You may need to download app files again. Do you wish to continue?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al app data vil slettes. Du skal muligvis downloade app-filer igen. Ønsker du at fortsætte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle App-Daten werden gelöscht. Du musst die App-Dateien vielleicht wieder installieren. Willst du fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All app data will be erased. You may need to download app files again. Do you wish to continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán todos los datos de la aplicación. Es posible que deba descargar los archivos de la aplicación nuevamente. ¿Continuar?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمامی داده‌های درون برنامه پاک خواهند شد. ممکن است نیاز باشد که دوباره آن‌ها را دریافت کنید. ادامه می‌دهید؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes données de l'app vont être effacées. Vous aurez peut être besoin de retélécharger des fichiers de l'app. Voulez-vous continuer ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप्लिकेशन का सारा डेटा मिटा दिया जाएगा. आपको ऐप फ़ाइलों को फिर से डाउनलोड करने की आवश्यकता हो सकती है। क्या आप जारी रखना चाहते हैं?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua data aplikasi akan dihapus. Anda mungkin perlu mengunduh file aplikasi lagi. Apakah anda ingin melanjutkan?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i dati dell'app verranno cancellati. Potrebbe essere necessario scaricare nuovamente i file dell'app. Vuoi continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの全てのデータが削除されます。もう一度ダウンロードする必要があるかもしれません。続けますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 앱 데이터가 삭제됩니다. 앱 내부 파일을 다시 다운로드해야 할 수 있습니다. 정말로 진행하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dados do aplicativo serão excluídos. Pode ser necessário baixar os arquivos do aplicativo novamente. Deseja continuar?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toată data de aplicație osa fie ștearsă. Poate osa trebuie sa descarci datele de aplicație din nou. Vrei sa continui?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все данные приложение будут удалены. Возможно, вам надо будет повторно скачать приложение. Вы хотите продолжить?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama verileri silinecektir. Dosyaları tekrar indirmeniz gerekebilir. Devam etmek istediğinize emin misiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All app data will be erased. You may need to download app files again. Do you wish to continue?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi dữ kiệu của ứng dụng sẽ bị xóa và bạn sẽ có thể phải lại toàn bộ chúng. Bạn chắc chứ?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有应用数据将被清除；有些软件可能需要重新下载数据。确定继续？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有應用程式數據將被清除； 有些軟體可能需要重新下載數據。確定繼續？"
          }
        }
      }
    },
