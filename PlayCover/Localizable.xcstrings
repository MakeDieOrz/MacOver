        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao definir a taxa de amostragem do dispositivo de saída atual para 48 kHz. Você pode manualmente definir a taxa de amostragem no aplicativo Configuração Áudio e MIDI"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu a setat rata de eșantionare de la dispozitivul curent la 48 KHz. Puteți seta manual rata de eșantionare în aplicația Audio MIDI Setup"
