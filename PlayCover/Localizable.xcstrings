    "keycover.toggle.startupPrompt.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover will prompt for your master password when you launch the application. If this is disabled, it will be prompted when you launch an app that uses PlayChain."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover will prompt for your master password when you launch the application. If this is disabled, it will be prompted when you launch an app that uses PlayChain."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover will prompt for your master password when you launch the application. If this is disabled, it will be prompted when you launch an app that uses PlayChain."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover fordert beim Starten der Anwendung nach deinem Master-Passwort. Wenn dies deaktiviert ist, wird es beim Starten einer App, die PlayChain verwendet, abgefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover will prompt for your master password when you launch the application. If this is disabled, it will be prompted when you launch an app that uses PlayChain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover le solicitará la contraseña maestra cuando se inicie la aplicación. Si se desactiva este comportamiento, se le solicitará cuando abra una aplicación que utilice PlayChain."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در زمان راه اندازی اولیه برنامه، KeyCover گذرواژه اصلی را از شما میپرسد. اگر غیرفعال باشد، هنگامی که برنامه ای را راه اندازی می کنید که از PlayChain استفاده می کند، گذرواژه اصلی از شما خواسته می شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover vous demandera votre mot de passe principal lorsque vous lancerez l'application. Si cette option est désactivée, elle vous sera demandée lorsque vous lancerez une application qui utilise PlayChain."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover will prompt for your master password when you launch the application. If this is disabled, it will be prompted when you launch an app that uses PlayChain।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover will prompt for your master password when you launch the application. If this is disabled, it will be prompted when you launch an app that uses PlayChain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover richiederà la tua password principale quando avvierai l'applicazione. Se disabilitato, verrà richiesta quando avvii un'app che utilizza PlayChain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover will prompt for your master password when you launch the application. If this is disabled, it will be prompted when you launch an app that uses PlayChain."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover가 애플리케이션을 시작할 때 마스터 암호를 묻는 메시지를 표시합니다. 사용 해제하면 PlayChain을 사용하는 앱을 시작할 때 메시지가 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover will prompt for your master password when you launch the application. If this is disabled, it will be prompted when you launch an app that uses PlayChain."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover will prompt for your master password when you launch the application. If this is disabled, it will be prompted when you launch an app that uses PlayChain."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover будет запрашивать ваш мастер-пароль при запуске этого приложения. Если отключено, тогда будет запрашиваться при запуске приложения, использующего PlayChain."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover uygulamayı açtığınızda ana şifrenizi isteyecektir. Eğer bu kapalıysa, PlayChain kullanan bir uygulamayı açtığınızda sorucaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover will prompt for your master password when you launch the application. If this is disabled, it will be prompted when you launch an app that uses PlayChain."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KeyCover sẽ nhắc bạn nhập mật khẩu chính của bạn khi bạn khởi chạy ứng dụng. Nếu bị tắt, nó sẽ được nhắc khi bạn khởi chạy một ứng dụng sử dụng PlayChain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您启动应用程序时，KeyCover将提示您输入主密码。如果禁用此选项，则当您启动使用PlayChain的应用程序时，系统会提示您。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你啓動應用程式時，KeyCover 會彈出視窗要求主密碼。如果停用這個功能，則當你啓動使用 PlayChain 的應用程式時才會彈出視窗。"
          }
        }
      }
    },
