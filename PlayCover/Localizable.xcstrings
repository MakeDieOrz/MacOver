      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses system iCloud Keychain directly. Requires SIP disabled and AMFI boot-args."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムの iCloud キーチェーンを直接使用します。SIP の無効化と AMFI のブート引数が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接使用系统与 iCloud 钥匙串。需关闭 SIP 并配置 AMFI 启动参数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接使用系統與 iCloud 鑰匙圈。需關閉 SIP 並設定 AMFI 開機參數。"
