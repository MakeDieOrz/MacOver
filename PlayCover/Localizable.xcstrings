      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayCover must be in the Applications folder to run correctly. Press the button below to move PlayCover automatically."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayCover must be in the Applications folder to run correctly. Press the button below to move PlayCover automatically."
          }
