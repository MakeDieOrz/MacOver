      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isolated per-app credential store. Keeps SIP and AMFI fully enabled without rebooting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリごとに分離された資格情報ストア。SIP と AMFI を完全に有効にしたまま、再起動も不要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单应用独立加密凭据存储，无需关闭系统完整性保护或重启电脑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單一應用程式獨立加密憑證儲存，無需關閉系統完整性保護或重新啟動電腦。"
          }
        }
      }
