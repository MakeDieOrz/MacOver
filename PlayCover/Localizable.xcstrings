    "alert.install.playToolsInformative" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools is a tool that allows you to bind keys to screen touches, custom display resolutions, and more, but it may break certain apps"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools is a tool that allows you to bind keys to screen touches, custom display resolutions, and more, but it may break certain apps"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools er et værktøj, der giver dig mulighed for at binde taster til skærmberøringer, brugerdefinerede skærmopløsninger og meget mere, men det kan ødelægge visse apps"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools ist ein Tool, mit dem du Tasten an Bildschirmberührungen, benutzerdefinierte Bildschirmauflösungen und mehr binden kannst, aber es kann bestimmte Apps beschädigen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools is a tool that allows you to bind keys to screen touches, custom display resolutions, and more, but it may break certain apps"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools es una herramienta que permite asignar teclas a toques en la pantalla, configurar resoluciones personalizadas, y más. Puede impactar negativamente el funcionamiento de algunas aplicaciones"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افزونه PlayTools به شما کمک می‌کند که از صفحه کلید برای کنترل برنامه استفاده کنید، رزولوشن آن راتغییر دهید و مواردی دیگر، اما ممکن است لازم باشد برای برخی برنامه‌ها آن را نصب نکنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools est un outil qui permet le mappage de touches, changement de résolution d'affichage et plus, mais elle peut briser certaines applications"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools एक ऐसा टूल है जो आपको स्क्रीन टच, कस्टम डिस्प्ले रेज़ोल्यूशन, और बहुत कुछ के लिए कुंजियों को बाइंड करने की अनुमति देता है, लेकिन यह कुछ ऐप्स को तोड़ सकता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools adalah alat yang memungkinkan Anda untuk mengikat tombol ke sentuhan layar, resolusi tampilan khusus, dan banyak lagi, tetapi dapat merusak aplikasi tertentu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools è uno strumento che ti permette di associare tasti ai tocchi dello schermo, risoluzioni display personalizzate e altro ancora, ma potrebbe rompere alcune app"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools は、キーをタッチスクリーンやカスタム ディスプレイ解像度などにバインドできるツールですが、特定のアプリが動作しなくなる可能性があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools는 화면 터치, 사용자 지정 디스플레이 해상도 등에 키를 바인딩할 수 있는 도구이지만 특정 앱에서 중단될 수 있습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PlayTools é uma ferramenta que permite mapear teclas para toques na tela, resoluções de exibição personalizados e mais, mas alguns aplicativos podem deixar de funcionar"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools is a tool that allows you to bind keys to screen touches, custom display resolutions, and more, but it may break certain apps"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools – это инструмент, позволяющий связывать нажатия клавиш с жестами экрана, устанавливать собственное разрешение экрана и т.д., однако он может нарушить корректную работу некоторых приложений"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools klavye haraketlerini ekranın belli yerlerine ayarlamayı, ekran çözünürlüğünü değiştirmeyi, ve daha fazlasını yapmanıza izin verir. Fakat bazı uygulamaları bozabilir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools is a tool that allows you to bind keys to screen touches, custom display resolutions, and more, but it may break certain apps"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools là một công cụ cho phép gán phím vào điều khiển cảm ứng, đặt độ phân giải tuỳ chỉnh, v.v. nhưng có thể làm lỗi một số ứng dụng nhất định"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools 是一个能帮您将键盘按键映射为触屏控制，自定义显示分辨率以及更多的工具，但它有可能使某些应用无法使用"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayTools是一個讓您將按鍵綁定到螢幕觸控，自定義顯示分辨率，和更多的工具，但它有可能會讓某些應用程序崩潰"
          }
        }
      }
    },
