    "configSigning.info.AMFI" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMFI is required to be turned off in order to allow fake signing of apps, allowing them to run with the correct Team ID"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMFI is required to be turned off in order to allow fake signing of apps, allowing them to run with the correct Team ID"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMFI skal være slået fra for at tillade falsk signering af apps, så de kan køre med det korrekte Team ID"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMFI muss deaktiviert werden, um das gefälschte Signieren von Apps zuzulassen, damit sie mit der richtigen Team-ID ausgeführt werden können"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMFI is required to be turned off in order to allow fake signing of apps, allowing them to run with the correct Team ID"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se require deshabilitar AMFI para permitir la firma falsa de aplicaciones, permitiendo así su ejecución con el ID de Equipo correcto"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای این‌که بتوان به برنامه‌ها اعتبار بخشید تا با TeamID درستی اجرا شوند، نیاز است که AMFI غیرفعال باشد"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'AMFI doit être désactivé afin de permettre la fausse signature des applications, leur permettant de s'exécuter avec le bon ID d'équipe"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप्स पर नकली हस्ताक्षर करने की अनुमति देने के लिए AMFI को बंद करना आवश्यक है, जिससे वे सही टीम आईडी के साथ चल सकें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMFI is required to be turned off in order to allow fake signing of apps, allowing them to run with the correct Team ID"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AMFI deve essere disabilitato per consentire la falsa firma delle app, permettendo loro di eseguire con il corretto ID Team"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの偽の署名を許可し、正しいチーム ID で実行できるようにするには、AMFI をオフにする必要があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가짜 서명을 허용하여 앱을 올바른 팀 ID로 실행하기 위해서는 AMFI를 종료해야 합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessário que o AMFI esteja desabilitado para que a assinar apps falsamente seja possível, permitindo-os que sejam executados com o ID de Time correto"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
