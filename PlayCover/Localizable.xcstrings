    "strict.mode.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enforces authentic iOS/iPadOS runtime parity: locks Jailbreak Bypass, Inline Syscall Interception, Root WorkDir, and native device display metrics while disabling debug hooks and notch simulation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS/iPadOS 実機に近いランタイム環境を強制します。脱獄検知回避、インラインシステムコールインターセプト、ルート作業ディレクトリ、デバイス固有の表示仕様をロックし、デバッグフックとノッチ模擬を無効化します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一键开启真实 iOS/iPadOS 运行时仿真：强制开启环境伪装、内联系统调用拦截与根目录兼容，锁定设备原生逻辑分辨率与倍率，并禁用调试钩子与刘海适配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一鍵開啟真實 iOS/iPadOS 執行時模擬：強制開啟繞過越獄檢測、內聯系統呼叫攔截與根目錄相容，鎖定裝置原生邏輯解析度與倍率，並停用除錯掛鉤與瀏海適配。"
          }
        }
      }
    },
