    "plugins.safeModeDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-shot Safe Mode temporarily skips UserPlugins, Network Rules, Frame Cap, iOS version override, and forces 1.0× scaling without altering your saved settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回限りのセーフモードでは、保存済みの設定を変更せずに、UserPlugins、ネットワークルール、フレームレート上限、iOS バージョンの上書きを一時的にスキップし、拡大率を 1.0× に固定します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单次安全模式会临时跳过第三方插件、网络规则、帧率限制、iOS 版本覆盖并将缩放重置为 1.0×，绝不会修改磁盘上已保存的配置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單次安全模式會暫時略過第三方外掛、網路規則、影格率限制、iOS 版本覆寫並將縮放重設為 1.0×，絕不會修改磁碟上已儲存的設定檔。"
          }
        }
      }
    },
