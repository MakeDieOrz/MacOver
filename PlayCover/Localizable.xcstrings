    "soundAlert.informativeText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current output device does not have a sample rate of 48 or 44.1 kHz! Crashes may occur. Would you like to change your current output device's sample rate to 48 kHz?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current output device does not have a sample rate of 48 or 44.1 kHz! Crashes may occur. Would you like to change your current output device's sample rate to 48 kHz?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din nuværende output-enhed har ikke en samplingfrekvens på 48 eller 44,1 kHz! Der kan opstå nedbrud. Vil du ændre din nuværende output-enheds samplingfrekvens til 48 kHz?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein aktuelles Ausgabegerät hat keine Abtastrate von 48 oder 44,1 kHz! Es kann zu Abstürzen kommen. Möchtest du die Abtastrate deines aktuellen Ausgabegeräts auf 48 kHz ändern?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current output device does not have a sample rate of 48 or 44.1 kHz! Crashes may occur. Would you like to change your current output device's sample rate to 48 kHz?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Su dispositivo de salida actual no tiene una frecuencia de muestreo de 48 o 44,1 kHz! Pueden ocurrir errores. ¿Le gustaría cambiar la frecuencia de muestreo de su dispositivo de salida actual a 48 kHz?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرخ نمونه‌برداری خروجی صوتی دستگاه شما ۴۸ و یا ۴۴/۱ کیلوهرتز نیست! ممکن است خرابی رخ دهد. آیا مایل هستید که آن را به ۴۸ کیلوهرتز تغییر دهید؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre sortie audio actuelle n'a pas un taux d'échantillonnage de 48 ou 44.1 kHz ! Des erreurs peuvent survenir. Voulez-vous changer le taux d'échantillonnage de votre sortie audio actuelle à 48 kHz ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके वर्तमान आउटपुट डिवाइस की नमूना दर 48 या 44.1 KHz नहीं है! दुर्घटनाएं हो सकती हैं। क्या आप अपने वर्तमान आउटपुट डिवाइस की नमूना दर को 48 KHz में बदलना चाहेंगे?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat keluaran Anda saat ini tidak memiliki laju sampel 48 atau 44,1 KHz! Kesalahan mungkin terjadi. Apakah Anda ingin mengubah laju sampel perangkat keluaran Anda saat ini menjadi 48 KHz?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo dispositivo di output corrente non ha un tasso di campionamento di 48 o 44,1 kHz! Potrebbero verificarsi crash. Desideri cambiare il tasso di campionamento del tuo dispositivo di output corrente a 48 kHz?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の出力デバイスのサンプルレートが48または44.1KHzではないため、問題が発生する可能性があります。現在のデバイスのサンプルレートを48KHzに変更しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 출력 장치의 샘플 레이트가 44.1 또는 48 KHz가 아닙니다! 충돌이 발생할 수 있습니다. 현재 출력 장치의 샘플 레이트를 48 kHz로 설정하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu dispositivo de saída atual não possui uma taxa de amostragem de 48 ou 44,1 kHz! Erros podem ocorrer. Deseja alterar a taxa de amostragem do seu dispositivo de saída atual para 48 kHz?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispozitivul curent nu are o frecvență de eșantionare de 48 sau 44.1 KHz! Pot apărea accidente. Vrei să modifici rata de eșantionare de la dispozitivul curent la 48 KHz?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше текущее устройство вывода не имеет частоты дискретизации 48 или 44,1 кГц! Могут возникнуть сбои. Хотели бы вы изменить частоту дискретизации вашего текущего устройства вывода на 48 кГц?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anki ses cihazınız 48 veya 44.1 kHz'yi desteklemiyor. Çökmeler yaşanabilir. Ses cihazınızın sample rate'ini 48kHz'ye değiştirmek istermisiniz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current output device does not have a sample rate of 48 or 44.1 kHz! Crashes may occur. Would you like to change your current output device's sample rate to 48 kHz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị đầu ra của bạn không hỗ trợ tốc độ lấy mẫu âm thanh ở mức 44.1 hay 48 KHz, có thể gây crash ứng dụng. Bạn có muốn điều chỉnh tốc độ lấy mẫu âm thanh không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现有的音频设备没有设置到 48 或 44.1 kHz 采样率！应用可能会崩溃。您希望把现有的音频设备设置成 48 kHz 采样率吗?"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現有的音訊設備並無 48 或 44.1 KHz 取樣率! 程式可能會崩潰。你希望把現有的音響設備設定成 48 KHz 取樣率嗎?"
          }
        }
      }
    },
