    "preferences.prune.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove all unused files including settings, keymappings, entitlements, and app data"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove all unused files including settings, keymappings, entitlements, and app data"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil fjerne alle filer ikke i brug som indstillinger, keymappinger, rettigheder, og app data"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies wird alle ungenutzte Dateien sowie Einstellungen, Tastenbelegungen, Berechtigungen und App-Daten löschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove all unused files including settings, keymappings, entitlements, and app data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará todos los archivos que no se utilicen, incluidos los de configuración, asignación de teclas, permisos y datos de la aplicación"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با این کار تمامی پیکربندی‌ها، Keymapها، دسترسی‌سازها و داده‌های برنامه‌هایی که در گذشته حذف شده‌اند و در PlayCover بلااستفاده باقی‌مانده‌اند، پاک خواهد شد"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera tous les fichiers inutilisés, y compris les paramètres, le mappage de touches, les autorisations et les données d'application"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सेटिंग्स, कीमैपिंग, एंटाइटेलमेंट और ऐप डेटा सहित सभी अप्रयुक्त फ़ाइलों को हटा देगा"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus semua file yang tidak digunakan termasuk pengaturan, pemetaan kontrol, hak, dan data aplikasi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eliminerà tutti i file inutilizzati come impostazioni, mappatura tasti, permessi e app data"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、設定、キーマッピング、エンタイトルメント、アプリデータなどのファイルがすべて削除されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정, 키매핑, 자격 증명, 앱 데이터를 포함한 모든 불필요한 것을 제거합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso irá excluir todos os arquivos não utilizados, incluindo configurações, mapeamento de teclas, permissões e dados do aplicativo"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asta osa ștearga toate fișierele neutilizate, setări, keymappings, entitlements, și datele de aplicație"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данное действие удалит все не используемые файлы, включая настройки, раскладки, разрешения и данные приложения"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılmayan bütün ayarlar, keymaplar, yetkiler ve uygulama verileri silinecektir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видалить всі невикористані файли включаючи налаштування, розкладку клавіатури, дозволи та дані застосунку"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi xác nhận, PlayCover sẽ gỡ bỏ các thiết lập, keymap và dữ liệu của ứng dụng cài qua PlayCover mà không dùng đến"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将删除所有未使用的文件，包括设置、按键映射、授权和应用程序数据"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將刪除所有未使用的檔案，包括設定、鍵盤映射、授權和應用程式數據"
          }
        }
      }
    },
