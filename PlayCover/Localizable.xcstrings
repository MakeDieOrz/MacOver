        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PlayCover precisa estar na pasta Aplicativos para funcionar corretamente. Pressione o botão abaixo para mover o PlayCover automaticamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
