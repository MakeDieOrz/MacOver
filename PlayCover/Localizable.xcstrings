          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể thiết lập được tốc độ lấy mẫu của thiết bị đầu ra hiện tại thành 48 KHz. Bạn có thể tùy chỉnh thủ công bằng app ‘Audio MIDI Setup’"
