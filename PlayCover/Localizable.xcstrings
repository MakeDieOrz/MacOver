    "settings.network.allowPinningBypass.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only bypasses NSURLSession pinning when a certificate validates cleanly against this app's custom CA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリのカスタム CA による厳密な X.509 検証に合格した場合のみ NSURLSession の Pinning を許可します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当服务器证书能通过本应用自定义 CA 的严格 X.509 校验时，才放行 NSURLSession Pinning。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅當伺服器憑證通過此 App 自訂 CA 的嚴格 X.509 驗證時，才放行 NSURLSession Pinning。"
          }
        }
      }
    },
