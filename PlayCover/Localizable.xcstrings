        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom plugins are arbitrary code that runs with full access to this app's process. Only add plugins from people you trust."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムプラグインは、このアプリのプロセスへのフルアクセス権で実行される任意のコードです。信頼できる提供元のプラグインのみを追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义插件将以完整权限在该应用进程内运行任意代码。请仅添加来自可信来源的插件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂外掛將以完整權限在此應用程式的程序內執行任意程式碼。請僅新增來自可信來源的外掛。"
          }
        }
      }
