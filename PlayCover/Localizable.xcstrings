      }
    },
    "safeMode.alert.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ exited abnormally within 3 seconds of launch. The next launch will automatically run in Safe Mode with user plugins and bypass hooks disabled."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は起動後 3 秒以内に異常終了しました。次回の起動は、ユーザプラグインと回避フックを無効にした状態で自動的にセーフモードで実行されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在启动后 3 秒内异常退出。下次启动将自动进入安全模式，并停用用户插件与绕过钩子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在啟動後 3 秒內異常結束。下次啟動將自動進入安全模式，並停用使用者外掛與繞過掛鉤。"
          }
        }
      }
    },
    "safeMode.alert.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Safe Mode"
          }
        },
        "ja" : {
          "stringUnit" : {
