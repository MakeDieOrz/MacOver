    "settings.network.certIsolationNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificates are isolated per app container runtime. Private keys stay host-only and macOS System Keychain is never modified."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証明書はアプリごとに分離され、秘密鍵はホスト側にのみ保持されます。macOS システムキーチェーンは変更しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "证书按应用严格隔离并仅注入运行时容器；私钥仅保留在宿主机侧，绝不修改 macOS 系统钥匙串。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "憑證依 App 容器隔離注入；私密金鑰僅存於主機側，絕不修改 macOS 系統鑰匙圈。"
          }
        }
      }
    },
