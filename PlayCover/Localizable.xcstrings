            "value" : "Añade soporte para teclado en juegos exclusivamente táctiles. Utilice Command + K para abrir el editor."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پشتیبانی از صفحه کلید را به بازی‌های لمسی اضافه می‌کند. از کلید‌های ترکیبی Command + K برای باز کردن ویرایشگر آن استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le mappage de touches aux jeux tactiles uniquement. Utilisez Commande + K pour ouvrir le menu de l'éditeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टच-ओनली गेम्स में कीबोर्ड सपोर्ट जोड़ें। संपादक मेनू खोलने के लिए Command + K का प्रयोग करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan dukungan keyboard ke game hanya sentuh. Gunakan Command + K untuk membuka menu editor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge il supporto alla tastiera ai giochi solo touch. Usa Comando + K per aprire il menu dell'editor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タッチスクリーンを使用する ゲームにキーボード サポートを追加します。 Command + K を使用してエディター メニューを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터치 전용 게임에 키보드 지원을 추가합니다. Command + K로 편집기 창을 열 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione suporte para jogos que só suportam toque na tela. Use Command + K para abrir o editor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adauga suport la tastatură pentru jocuri cu doar atingere. Folosește Command + K ca-sa deschizi meniul de edita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить поддержку клавиатуры для игр только с тач-интерфейсом. Нажмите Command + K, чтобы открыть меню редактирования."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece dokunmatik ekran destekleyen ugyulamalara klavye ekleyin. Editörü açmak için Commnand + K ye basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add keyboard support to touch-only games. Use Command + K to open editor menu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm hỗ trợ bàn phím cho các trò chơi/ứng dụng chưa/không hỗ trợ SDK. Sử dụng tổ hợp Command + K để mở trình chỉnh sửa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为仅支持触摸游戏添加键盘支持，使用 Command + K 打开编辑菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為僅可透過觸控螢幕操控的遊戲添加鍵盤支援。使用 Command + K 開啟編輯器選單。"
          }
        }
      }
    },
