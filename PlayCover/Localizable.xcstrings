    "soundAlert.failureText" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to set current output device's sample rate to 48 kHz. You can manually set sample rate in the Audio MIDI Setup app"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to set current output device's sample rate to 48 kHz. You can manually set sample rate in the Audio MIDI Setup app"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det lykkedes ikke at indstille den aktuelle output-enheds samplingfrekvens til 48 kHz. Du kan manuelt indstille samplefrekvensen i appen Audio MIDI Setup"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abtastrate des aktuellen Ausgabegeräts konnte nicht auf 48 kHz eingestellt werden. Du kannst die Abtastrate in der Audio-MIDI-Setup-App manuell einstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to set current output device's sample rate to 48 kHz. You can manually set sample rate in the Audio MIDI Setup app"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubo un error al establecer la frecuencia de muestreo a 48 kHz en el dispositivo de salida. Puedes hacer esto manualmente en la aplicación en la Configuración de Audio MIDI"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغییر نرخ نمونه‌برداری خروجی صوتی به ۴۸ کیلوهرتز با شکست مواجه شد. شما می‌توانید آن را به صورت دستی در نرم‌افزار Audio MIDI Setup مک خود، تغییر دهید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une error a occurée en essayant de régler la fréquence d'échantillonnage du périphérique de sortie actuel à 48 kHz. Vous pouvez régler manuellement la fréquence d'échantillonnage dans l'application Audio MIDI Setup"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वर्तमान आउटपुट डिवाइस की नमूना दर को 48 KHz पर सेट करने में विफल। आप ऑडियो MIDI सेटअप ऐप में मैन्युअल रूप से नमूना दर सेट कर सकते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal menyetel laju sampel perangkat keluaran saat ini ke 48 KHz. Anda dapat mengatur sample rate secara manual di aplikasi 'Audio MIDI Setup'"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile impostare il tasso di campionamento del dispositivo di output corrente su 48 kHz. Puoi impostare manualmente il tasso di campionamento nell'app Audio MIDI Setup"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンプルレートの変更に失敗しました。「Audio MIDI設定」アプリから手動でサンプルレートを設定することができます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 출력 장치의 샘플 레이트를 48 kHz로 설정하지 못했습니다. ‘오디오 MIDI 설정’ 앱에서 수동으로 샘플 레이트를 설정할 수 있습니다"
