    "settings.toggle.blockSleepSpamming.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent the app from spamming the usleep() syscall which may cause resource exhaustion"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リソース枯渇の原因となる usleep() システムコールの過剰な呼び出しを防止します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止应用高频调用 usleep() 系统调用导致资源耗尽"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止應用程式高頻呼叫 usleep() 系統呼叫導致資源耗盡"
          }
        }
      }
    },
