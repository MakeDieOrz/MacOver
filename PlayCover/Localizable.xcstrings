    "settings.toggle.ignoreUnityKeyboardInitializationError.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent a crash caused by the assertion failure \"[KeyboardDelegate Initialize] called after creating keyboard\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アサーション失敗 \"[KeyboardDelegate Initialize] called after creating keyboard\" によるクラッシュを防止します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止因断言失败 \"[KeyboardDelegate Initialize] called after creating keyboard\" 导致的闪退"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止因斷言失敗 \"[KeyboardDelegate Initialize] called after creating keyboard\" 導致的閃退"
          }
        }
      }
    },
    "settings.toggle.interceptInlineSyscalls" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercept inline syscalls (Experimental)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インラインシステムコールをインターセプト（実験的）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拦截内联系统调用（试验性）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "攔截內聯系統呼叫（實驗性）"
          }
        }
      }
    },
    "settings.toggle.interceptInlineSyscalls.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reversibly patches inline ARM64 svc #0x80 instructions in app binaries on launch and restores original bytes in memory queries. Requires restarting the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時にアプリバイナリ内のインライン ARM64 svc #0x80 命令を可逆的にパッチし、メモリ読み取り時に元のバイト列を復元します。変更にはアプリの再起動が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在启动时可逆地将应用二进制中的内联 ARM64 svc #0x80 替换为内部拦截陷阱，并在内存读取检测时还原原始指令。更改需重启应用后生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在啟動時可逆地修補應用二進位檔案中的內聯 ARM64 svc #0x80 指令，並在記憶體讀取檢查時還原原始位元組。變更需重新啟動應用。"
          }
        }
      }
    },
    "settings.toggle.interceptInlineSyscalls.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental: Modifies signed code pages on launch and re-signs locally; anti-cheat integrity checks or strict code signing may crash or trigger detections. Toggling off or launching in Safe Mode automatically restores original bytes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実験的機能: 起動時にコード署名ページを変更してローカルで再署名するため、厳格な整合性検証やアンチチートでクラッシュや検知が発生する可能性があります。無効化またはセーフモード起動時に自動で元のバイトへ復元されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试验性功能：会在启动时修改并重新本地签名应用二进制，部分强完整性校验或防作弊仍可能崩溃或触发检测；关闭开关或以安全模式启动会自动无损还原。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "實驗性功能：會在啟動時修改並重新本機簽章應用二進位檔案，嚴格完整性驗證或防作弊可能導致閃退或觸發偵測；關閉開關或安全模式啟動時會自動還原原始位元組。"
          }
        }
      }
    },
