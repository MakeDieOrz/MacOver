    "device.mSeriesNotice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple M-series iPad profiles expose a desktop-class Metal GPU profile (applegpu_g13g–g18g). For apps expecting A-series iPad or iPhone GPU parity, choose iPad Pro A12X or an iPhone profile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple M シリーズ iPad プロファイルはデスクトップ級 Metal GPU プロファイル（applegpu_g13g–g18g）を公開します。A シリーズ iPad または iPhone の GPU 互換を要求するアプリには iPad Pro A12X または iPhone プロファイルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M 系列 iPad 机型会暴露桌面级 Metal GPU 配置（applegpu_g13g–g18g）；若应用严格校验 A 系列 iPad 或 iPhone GPU，可改选 A12X iPad 或 iPhone 机型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M 系列 iPad 機型會暴露桌面級 Metal GPU 設定（applegpu_g13g–g18g）；若應用嚴格驗證 A 系列 iPad 或 iPhone GPU，請改選 A12X iPad 或 iPhone 機型。"
          }
        }
      }
    },
