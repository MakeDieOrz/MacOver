      }
    },
    "signing.wizard.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Disable SIP in macOS Recovery (`csrutil disable`), then boot back into macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. macOS 復旧モードで SIP を無効にし（`csrutil disable`）、macOS を再起動します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 在 macOS 恢复模式终端关闭 SIP（`csrutil disable`）并重新进入系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 在 macOS 復原模式終端機關閉 SIP（`csrutil disable`）並重新進入系統。"
          }
        }
      }
    },
    "signing.wizard.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Enable AMFI bypass boot arguments via MacOver Helper or Terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. MacOver Helper またはターミナルで AMFI 回避用のブート引数を有効にします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 通过 MacOver Helper 或终端写入 AMFI 启动参数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 透過 MacOver Helper 或終端機寫入 AMFI 開機參數。"
          }
        }
      }
    },
    "signing.wizard.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Reboot once for NVRAM changes to take effect. To revert later, run `sudo nvram -d boot-args` and `csrutil enable`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. NVRAM の変更を反映するため一度再起動します。後で元に戻すには `sudo nvram -d boot-args` と `csrutil enable` を実行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 重启一次 Mac 使参数生效；如需恢复默认，请运行 `sudo nvram -d boot-args` 并 `csrutil enable`。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 重新啟動 Mac 一次使參數生效；如需恢復預設，請執行 `sudo nvram -d boot-args` 並 `csrutil enable`。"
          }
        }
      }
    },
    "signing.wizard.title" : {
      "extractionState" : "manual",
