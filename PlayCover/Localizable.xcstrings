    "configSigning.subtext" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Package Signing helps fixing issues with apps that rely on \ncorrect Team IDs for operations like authorization. \nThere may be security risks associated with enabling this feature.\n\n As such, we recommend disabling it when it's not necessary"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Package Signing helps fixing issues with apps that rely on \ncorrect Team IDs for operations like authorization. \nThere may be security risks associated with enabling this feature.\n\n As such, we recommend disabling it when it's not necessary"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakkesignering hjælper med at løse problemer med apps, der er afhængige af \nkorrekte team-id'er for handlinger som autorisation. \nDer kan være sikkerhedsrisici forbundet med at aktivere denne funktion.\n\nDerfor anbefaler vi at deaktivere det, når det ikke er nødvendigt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Paketsignierung hilft bei der Behebung von Problemen mit Apps, \ndie für Vorgänge wie die Autorisierung auf korrekte Team-IDs angewiesen sind. \nMit der Aktivierung dieser Funktion können Sicherheitsrisiken verbunden sein.\n\n Daher empfehlen wir, es zu deaktivieren, wenn es nicht erforderlich ist"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Package Signing helps fixing issues with apps that rely on \ncorrect Team IDs for operations like authorization. \nThere may be security risks associated with enabling this feature.\n\n As such, we recommend disabling it when it's not necessary"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma de paquetes ayuda a arreglar problemas con aplicaciones que dependen de \nIDs de Equipo correctos para operaciones como la autorización. \nPueden haber riesgos de seguridad derivados de la habilitación de esta característica.\n\nPor esta razón, se recomienda deshabilitarla cuando su uso no es requerido"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعتباربخشی به بسته‌ها به رفع مشکلاتی مانند ورود به حساب کاربری\nبرنامه‌هایی که به TeamID درستی نیاز دارند، کمک می‌کند.\nانجام این کار با مقداری ریسک امنیتی برای دستگاه‌تان درخور است.\n\nبه این خاطر ما پیشنهاد می‌کنیم تنها در صورت نیاز آن را فعال کنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La signature de package permet de résoudre les problèmes avec les applications qui dépendent des\nID d'équipe pour des opérations telles que l'autorisation.\nIl peut y avoir des risques de sécurité associés à l'activation de cette fonctionnalité.\n\n En tant que tel, nous vous recommandons de le désactiver lorsque ce n'est pas nécessaire"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैकेज साइनिंग उन ऐप्स के साथ समस्याओं को ठीक करने में मदद करता है, जिन पर भरोसा किया जाता है\nप्राधिकरण जैसे संचालन के लिए सही टीम आईडी।\nइस सुविधा को सक्षम करने से जुड़े सुरक्षा जोखिम हो सकते हैं।\n\n इस प्रकार, जब आवश्यक न हो तो हम इसे अक्षम करने की अनुशंसा करते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Package Signing helps fixing issues with apps that rely on \ncorrect Team IDs for operations like authorization. \nThere may be security risks associated with enabling this feature.\n\n As such, we recommend disabling it when it's not necessary"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Firma del Pacchetto aiuta a risolvere problemi con le app\nche dipendono da ID Team corretti per operazioni come l'autorizzazione.\nPotrebbero esserci rischi per la sicurezza associati all'abilitazione di questa funzione.\n\nPertanto, raccomandiamo di disabilitarla quando non è necessaria"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パッケージ署名は、承認などの操作のための正しいチーム IDに\n依存するアプリの問題を修正するのに役立ちます。\nこの機能を有効にすると、セキュリティ リスクが生じる可能性があります。\n\nそのため、不要な場合は無効にすることをお勧めします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패키지 서명은 인증 같은 작업을 위해 올바른 팀 ID를 필요로 하는 \n앱의 문제를 해결하는 데 도움이 됩니다. \n이 기능을 사용 설정하면 보안 위험이 발생할 수 있습니다.\n\n 따라서 필요하지 않다면 사용하지 않는 것이 좋습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assinar Pacotes ajuda a resolver problemas com \naplicativos que dependem de IDs de Time corretos para operações como autorizações. \nPodem haver riscos de segurança associados a essa funcionalidade.\n\n Portanto, recomenda-se desativa-la quando não for necessário"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Package Signing helps fixing issues with apps that rely on \ncorrect Team IDs for operations like authorization. \nThere may be security risks associated with enabling this feature.\n\n As such, we recommend disabling it when it's not necessary"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпись пакетов помогает исправлять проблемы с приложениями которые полагаются на \nправильные идентификаторы команд для таких операций, как авторизация. \nВключение этой функции может быть связано с рисками безопасности.\n\n Таким образом, мы рекомендуем отключить его, когда в этом нет необходимости"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket İmzalamak Takım ID'lerine bağlı olan\nuygulamalar için yardım edebilir.\nBu özellikle gizlilik sıkıntıları yaşanabilir.\n\nBu yüzden gerekli olmadıkça kapalı kalmasını öneririz"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Package Signing helps fixing issues with apps that rely on \ncorrect Team IDs for operations like authorization. \nThere may be security risks associated with enabling this feature.\n\n As such, we recommend disabling it when it's not necessary"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng Package Signing giúp khắc phục sự cố với các ứng dụng dựa vào \nTeam ID chính xác cho các hoạt động như xác thực. \nCó thể có những rủi ro bảo mật liên quan đến việc bật tính năng này.\n\nDo đó, chúng tôi khuyên bạn nên tắt nó khi không cần thiết"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "软件包签名有助于解决应用程序的问题，这些应用程序在授权等操作上依赖 \n正确的 团队ID 进行授权等操作。\n启用这一功能可能会有安全风险。\n\n因此，我们建议在不需要时禁用它"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "應用程式包簽名幫助修復需要依靠正確 團隊 ID\n來處理身分驗證等操作的應用程序。\n這個功能有可能會帶來風險。\n\n因此，我們建議在不必要的情況下禁用它"
          }
        }
      }
    },
