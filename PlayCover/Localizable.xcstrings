        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルート作業ディレクトリはオンにロックされ、PlayChain デバッグ、イントロスペクション、Metal HUD、LLDB はオフにロックされています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严格仿真模式下已强制锁定开启根目录兼容，并锁定关闭 PlayChain 调试、内省库、Metal HUD 与 LLDB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嚴格模擬模式下已強制鎖定開啟根目錄相容，並鎖定關閉 PlayChain 調試、內檢庫、Metal HUD 與 LLDB。"
          }
        }
      }
    },
    "strict.lockedPane.help" : {
