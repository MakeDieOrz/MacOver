      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear Safe Mode"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セーフモードを解除"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除安全模式"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除安全模式"
          }
